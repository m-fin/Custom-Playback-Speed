{
    "name": "Custom Playback Speed",
    "version": "0.3.0",
    "manifest_version": 3,
    "description": "Set the playback speed of videos in your browser to any number.",
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "Set playback speed",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png",
        "256": "icons/icon256.png"
    },
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Alt+Shift+S"
            },
            "description": "Set playback speed"
        },
        "speed-up": {
            "suggested_key": {
                "default": "Alt+Shift+Period"
            },
            "description": "Speed up by one step"
        },
        "speed-down": {
            "suggested_key": {
                "default": "Alt+Shift+Comma"
            },
            "description": "Slow down by one step"
        },
        "speed-reset": {
            "suggested_key": {
                "default": "Alt+Shift+0"
            },
            "description": "Reset playback speed to 1x"
        }
    }
}
