{
    "name": "Custom Playback Speed",
    "version": "0.1.0",
    "manifest_version": 3,
    "description": "Set the playback speed of videos in your browser to any number.",
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "Set playback speed",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png",
        "256": "icons/icon256.png"
    }
}
